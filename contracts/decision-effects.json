{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "smart-memory-graph/contracts/decision-effects.json",
  "title": "Decision effects, phase 1",
  "$ref": "#/$defs/DecisionEffectsSnapshot",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "Text": {
      "type": "string",
      "pattern": "\\S"
    },
    "Date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "Freshness": {
      "type": "object",
      "properties": {
        "kind": { "const": "computed" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "EffectsNode": {
      "type": "object",
      "properties": {
        "viaSuggested": { "type": "boolean" },
        "id": { "$ref": "#/$defs/Id" },
        "label": { "type": "string" },
        "type": { "enum": ["decision", "note", "entity"] },
        "hop": {
          "type": "integer",
          "minimum": 0
        },
        "validFrom": { "$ref": "#/$defs/Date" },
        "retiredAt": { "$ref": "#/$defs/Date" },
        "retirement": { "enum": ["replaced", "retracted"] },
        "reason": { "type": "string" },
        "rejected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ruleKind": { "enum": ["must", "must-not"] },
        "check": { "const": "unchecked" },
        "importance": { "type": "number" }
      },
      "required": ["id", "label", "type", "hop", "validFrom"],
      "additionalProperties": false
    },
    "EffectsEdge": {
      "type": "object",
      "properties": {
        "suggested": { "type": "boolean", "description": "On stored depends_on edges, true for a suggestion and false for a confirmed or manually stated link." },
        "id": { "$ref": "#/$defs/Id" },
        "source": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/Id" },
        "type": { "enum": ["depends_on", "comes_from", "supersedes"] },
        "derived": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/Freshness" }
      },
      "required": ["id", "source", "target", "type"],
      "additionalProperties": false
    },
    "EffectsGraphData": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/EffectsNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/EffectsEdge" }
        }
      },
      "required": ["nodes", "edges"],
      "additionalProperties": false
    },
    "Settlement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "choice": { "const": "replace" }
          },
          "required": ["choice"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "choice": { "const": "keep_both_scoped" },
            "scope": { "$ref": "#/$defs/Text" }
          },
          "required": ["choice", "scope"],
          "additionalProperties": false
        }
      ]
    },
    "Resolution": {
      "oneOf": [
        { "$ref": "#/$defs/Settlement" },
        {
          "type": "object",
          "properties": {
            "choice": { "const": "cancel" }
          },
          "required": ["choice"],
          "additionalProperties": false
        }
      ]
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "why": { "$ref": "#/$defs/Text" },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "resolution": { "$ref": "#/$defs/Settlement" }
      },
      "required": ["id", "why", "freshness"],
      "additionalProperties": false
    },
    "Drop": {
      "type": "object",
      "description": "A rule the draft replaces, and the requirement of it the draft drops (the judge's words, plain). Settled at commit by a resolution keyed by `id`: replace (Replace anyway) or cancel.",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "dropped": { "$ref": "#/$defs/Text" }
      },
      "required": ["id", "dropped"],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "via": { "$ref": "#/$defs/Id" },
        "hop": {
          "type": "integer",
          "minimum": 1
        },
        "state": { "enum": ["preview", "flagged"] },
        "freshness": { "$ref": "#/$defs/Freshness" }
      },
      "required": ["id", "via", "hop", "state", "freshness"],
      "additionalProperties": false
    },
    "ConflictCheck": {
      "type": "object",
      "description": "Scope of the conflict check of a draft. Every related rule is judged, in calls of up to `cap` rules, up to the workspace ceiling. checked: every related rule judged. no_related_rule: the lookup proved it finished and found no related rule while rules are in force. nothing_to_check: no other rule in force. partial: more related rules than the ceiling; the closest `ceiling` were judged, `omitted` were not (a lower bound when `omitted_at_least`), and `save_allowed` is the workspace setting decisions.effects.save_on_partial_check. could_not_check: a lookup step or a judge call did not finish; never cleared, try again.",
      "properties": {
        "state": { "enum": ["checked", "no_related_rule", "nothing_to_check", "partial", "could_not_check"] },
        "checked": { "type": "integer", "minimum": 0 },
        "cap": { "const": 10 },
        "omitted": { "type": "integer", "minimum": 0 },
        "ceiling": { "type": "integer", "minimum": 10, "maximum": 1000 },
        "save_allowed": { "type": "boolean" },
        "omitted_at_least": { "type": "boolean" }
      },
      "required": ["state", "checked", "cap", "omitted"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "checked" } } },
          "then": { "properties": { "checked": { "minimum": 1 }, "omitted": { "const": 0 } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["nothing_to_check", "no_related_rule"] } } },
          "then": { "properties": { "checked": { "const": 0 }, "omitted": { "const": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "partial" } } },
          "then": {
            "properties": { "checked": { "minimum": 1 }, "omitted": { "minimum": 1 } },
            "required": ["ceiling", "save_allowed", "omitted_at_least"]
          },
          "else": { "not": { "anyOf": [{ "required": ["ceiling"] }, { "required": ["save_allowed"] }, { "required": ["omitted_at_least"] }] } }
        }
      ]
    },
    "Counts": {
      "type": "object",
      "properties": {
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "replaced": {
          "type": "integer",
          "minimum": 0
        },
        "to_review": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["conflicts", "replaced", "to_review"],
      "additionalProperties": false,
      "description": "Totals before display limits. Exclude wording-only matches."
    },
    "Related": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "type": "string" }
      },
      "required": ["id", "label"],
      "additionalProperties": false
    },
    "Overflow": {
      "type": "object",
      "properties": {
        "date": { "$ref": "#/$defs/Date" },
        "hop": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "branchId": { "$ref": "#/$defs/Id" }
      },
      "required": ["date", "hop", "count", "branchId"],
      "additionalProperties": false,
      "description": "Actual number omitted from data for this date, hop and refocus branch."
    },
    "DecisionEffectsSnapshot": {
      "type": "object",
      "properties": {
        "suggestedLinks": { "enum": ["suggest_only", "dashed", "treat_as_real"], "default": "dashed" },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "$ref": "#/$defs/Id" },
              "target": { "$ref": "#/$defs/Id" },
              "reason": { "$ref": "#/$defs/Text" }
            },
            "required": ["source", "target", "reason"],
            "additionalProperties": false
          }
        },
        "data": { "$ref": "#/$defs/EffectsGraphData" },
        "focus": { "$ref": "#/$defs/Id" },
        "today": { "$ref": "#/$defs/Date" },
        "revision": { "type": "string" },
        "phase": { "enum": ["draft", "standing", "held"] },
        "policy": { "enum": ["save", "propose"] },
        "replaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        },
        "drops": {
          "type": "array",
          "items": { "$ref": "#/$defs/Drop" },
          "description": "Draft only. The replaced rules (each also in `replaces`) the draft drops a requirement of. Absent when the workspace setting decisions.effects.replacement_drop_check is off, or on a host without the check."
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conflict" }
        },
        "review": {
          "type": "array",
          "items": { "$ref": "#/$defs/Review" }
        },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "whyPaths": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Id" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/Id" },
            "minItems": 2,
            "maxItems": 6
          }
        },
        "conflict_check": { "$ref": "#/$defs/ConflictCheck" },
        "counts": { "$ref": "#/$defs/Counts" },
        "possibly_related": {
          "type": "array",
          "items": { "$ref": "#/$defs/Related" }
        },
        "overflow": {
          "type": "array",
          "items": { "$ref": "#/$defs/Overflow" }
        }
      },
      "required": ["data", "focus", "today", "phase", "replaces", "conflicts", "review", "freshness", "counts", "possibly_related", "overflow"],
      "additionalProperties": false
    },
    "EffectsRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" }
      },
      "required": ["id"],
      "additionalProperties": false,
      "description": "Path parameters. No request body."
    },
    "StandingEffectsOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": { "$ref": "#/$defs/Date" },
        "show_retired": { "type": "boolean" }
      }
    },
    "PreviewResponse": {
      "$ref": "#/$defs/DecisionEffectsSnapshot",
      "type": "object",
      "properties": { "phase": { "const": "draft" }, "conflict_check": { "$ref": "#/$defs/ConflictCheck" } },
      "required": ["phase", "conflict_check"]
    },
    "PreviewRequest": {
      "type": "object",
      "properties": {
        "text": { "$ref": "#/$defs/Text" },
        "as_of": {
          "$ref": "#/$defs/Date",
          "description": "Defaults to today in the workspace calendar. Reject any other date."
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "CommitRequest": {
      "type": "object",
      "properties": {
        "text": { "$ref": "#/$defs/Text" },
        "resolutions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Id" },
          "additionalProperties": { "$ref": "#/$defs/Resolution" }
        }
      },
      "required": ["text", "resolutions"],
      "additionalProperties": false,
      "description": "Recompute the authoritative conflict set under the caller scope before writing. Require exactly one entry for each conflict id. For missing entries return 409 naming the missing ids and write nothing. An empty map settles a conflict-free draft. Any cancel aborts the whole write. A draft with `drops` also needs one entry per drop, keyed by the replaced rule's id: replace (Replace anyway) or cancel; a missing one is named in the same 409. An entry keyed by a replaced rule with no drop is accepted."
    },
    "UnsettledConflict": {
      "type": "object",
      "properties": {
        "conflict_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Conflict ids, and the ids of replaced rules whose drop has no resolution."
        }
      },
      "required": ["conflict_ids"],
      "additionalProperties": false
    },
    "CommitReply": {
      "oneOf": [
        { "$ref": "#/$defs/DecisionEffectsSnapshot" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "cancelled" }
          },
          "required": ["status"],
          "additionalProperties": false
        }
      ]
    },
    "DependsOnRequest": {
      "type": "object",
      "properties": {
        "target_id": { "$ref": "#/$defs/Id" }
      },
      "required": ["target_id"],
      "additionalProperties": false,
      "description": "Body. The path id is the dependent decision."
    },
    "DependsOnReply": {
      "type": "object",
      "properties": {
        "source": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/Id" },
        "type": { "const": "depends_on" }
      },
      "required": ["source", "target", "type"],
      "additionalProperties": false
    }
  }
}
